{
  "name": "wiki-sample",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "hexclave dev --config-file ./hexclave.config.ts -- npm run dev:inner",
    "dev:inner": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:seed": "tsx src/db/seed.ts",
    "db:sync-users": "hexclave dev --config-file ./hexclave.config.ts -- tsx src/db/sync-all-users.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@hexclave/next": "^1.0.123",
    "@neondatabase/serverless": "^1.1.0",
    "@uiw/react-md-editor": "^4.1.2",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.3.3",
    "dotenv": "^18.0.3",
    "drizzle-orm": "^0.45.3",
    "lucide-react": "^1.47.0",
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "shadcn": "^4.21.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@hexclave/cli": "^1.0.123",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "drizzle-seed": "^0.3.1",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
